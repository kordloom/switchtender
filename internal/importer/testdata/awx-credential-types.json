{
  "credential_types": [
    {
      "name": "Kubeconfig",
      "description": "A kubeconfig file for the kubernetes.core collection",
      "kind": "cloud",
      "managed": false,
      "inputs": {
        "fields": [
          {"id": "kube_config", "type": "string", "label": "Kubeconfig", "secret": true,
           "multiline": true, "help_text": "Paste the whole file"}
        ],
        "required": ["kube_config"]
      },
      "injectors": {
        "file": {"template": "{{ kube_config }}"},
        "env": {"K8S_AUTH_KUBECONFIG": "{{ tower.filename }}"}
      },
      "natural_key": {"name": "Kubeconfig", "kind": "cloud", "type": "credential_type"}
    },
    {
      "name": "Client Certificate",
      "kind": "net",
      "inputs": {
        "fields": [
          {"id": "cert", "label": "Certificate", "multiline": true},
          {"id": "key", "label": "Key", "secret": true, "multiline": true, "format": "ssh_private_key"},
          {"id": "verify", "label": "Verify", "type": "boolean", "default": true}
        ]
      },
      "injectors": {
        "file": {"template.cert": "{{ cert }}", "template.key": "{{ key }}"},
        "env": {"TLS_CERT_FILE": "{{ tower.filename.cert }}", "TLS_VERIFY": "{{ verify }}"},
        "extra_vars": {"tls_key_file": "{{ awx.filename.key }}"}
      }
    },
    {
      "name": "Templated Token",
      "kind": "cloud",
      "inputs": {"fields": [{"id": "token", "label": "Token", "secret": true}]},
      "injectors": {"env": {"API_TOKEN": "{{ token | b64encode }}"}}
    },
    {
      "name": "Machine",
      "kind": "ssh",
      "managed": true,
      "inputs": {"fields": [{"id": "username", "label": "Username"}]},
      "injectors": {}
    }
  ],
  "credentials": [
    {"name": "prod-kube", "credential_type": {"name": "Kubeconfig", "kind": "cloud"},
     "inputs": {"kube_config": "$encrypted$"}},
    {"name": "edge-cert", "credential_type": {"name": "Client Certificate", "kind": "net"},
     "inputs": {"cert": "-----BEGIN CERTIFICATE-----", "key": "$encrypted$", "verify": true}},
    {"name": "api-token", "credential_type": {"name": "Templated Token", "kind": "cloud"},
     "inputs": {"token": "$encrypted$"}}
  ]
}
